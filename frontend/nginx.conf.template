# Unity WebGL 번들(frontend/Build) 정적 서빙 + backend API 리버스 프록시 설정.
#
# ⚠️ 이 파일은 **템플릿**이다(#266 3단계). docker-compose.yml의 frontend 서비스가
# /etc/nginx/templates/default.conf.template로 마운트하고, nginx:alpine의 기동
# 스크립트(/docker-entrypoint.d/20-envsubst-on-templates.sh)가 envsubst로 `${...}`를
# 치환해 /etc/nginx/conf.d/default.conf를 만든다. 예전처럼 conf.d에 직접 마운트하면
# `${FINUS_API_KEY}`가 치환되지 않은 채 남고, nginx는 그것을 정의되지 않은 변수로 보고
# **기동 자체에 실패한다** — 정적 화면까지 함께 죽는다.
#
# 치환 대상은 compose의 `NGINX_ENVSUBST_FILTER: ^FINUS_`로 FINUS_* 하나로 좁혀 뒀다.
# 그 필터의 기본값은 "환경에 정의된 모든 변수"라, 컨테이너 환경에 nginx 변수와 같은
# 이름이 생기는 날 이 파일의 `$host`·`$uri`가 조용히 치환된다.
#
# 이 파일은 nginx 기본 nginx.conf의 http 블록 안에서 include되므로, 아래 map·server는
# 모두 http 컨텍스트에 놓인다.

# WebSocket 업그레이드 중계용. Connection: upgrade를 무조건 박으면 평범한 GET에도
# 빈 Upgrade 헤더와 함께 나가므로, 클라이언트가 실제로 업그레이드를 요청했을 때만 보낸다.
# /api/v1/ws(backend/main.py)가 이 경로를 탄다.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- 레이트리밋 zone (#266 1단계) ---
#
# `/api/v1/analyze`는 무인증이면서 호출 한 번이 LLM(OpenAI/Anthropic) 또는 NAT 멀티
# 에이전트를 태워 직접 과금으로 이어진다. CORS는 이 위험의 방어가 되지 않는다 —
# 응답을 *읽는* 것만 막고 요청 *실행*은 막지 못하므로, 임의 페이지의
# `fetch(..., { mode: "no-cors" })` 한 줄이면 호출이 실제로 나간다. 그래서 프록시
# 지점에서 건다: backend 코드를 건드리지 않고 한 자리에서 걸린다.
#
# 이 파일은 http 컨텍스트에 include되므로 zone 정의를 여기 둘 수 있다(server 안에서는
# 정의할 수 없다). 키는 `$binary_remote_addr`다 — `$remote_addr`의 문자열 표현보다
# 상태가 작고, 앞단이 nginx 자신이라 클라이언트가 위조할 수 없는 값이다. 앞단에
# CDN·LB를 두게 되면 이 키는 그 장비의 주소 하나로 수렴해 전 사용자가 한 버킷을
# 공유하므로, `proxy_set_header X-Forwarded-For`를 되돌리는 것과 함께 키도
# `$http_x_forwarded_for` 계열로 옮겨야 한다(위 X-Forwarded-For 주석과 같은 자리).
#
# zone 크기 1m은 약 16,000개 주소분의 상태다. 단일 사용자 + Tailscale 시연 규모에는
# 과분하고, 넘치면 nginx가 가장 오래된 상태를 버린 뒤 그래도 모자라면 503을 낸다.
#
# rate는 nginx가 "요청 간 최소 간격"으로 환산한다. 2r/s = 0.5초에 1건, 6r/m = 10초에
# 1건이다. 두 표기를 섞어 쓰지 않도록, 문서에 적는 값과 같은 단위로 적는다.
limit_req_zone $binary_remote_addr zone=finus_api:1m rate=2r/s;
limit_req_zone $binary_remote_addr zone=finus_analyze:1m rate=6r/m;

# 레이트(속도)만으로는 이 배포의 실제 비용을 못 막는다. analyze 한 건은
# `proxy_read_timeout 300s`가 허용하는 만큼 오래 살아 있을 수 있으므로, 간격을 지키며
# 천천히 밀어 넣어도 동시에 진행 중인 LLM 호출은 계속 쌓인다. 동시 연결 수를 함께
# 제한해 "진행 중인 고비용 작업"의 상한을 직접 못 박는다.
limit_conn_zone $binary_remote_addr zone=finus_analyze_conn:1m;

# --- 번들에 API 키를 실어 보내기 (#266 3단계) ---
#
# 2단계가 backend에 정적 키 인증을 걸었지만 추적 중인 Unity WebGL 번들은 그 키를 보내지
# 못했다 — `ApiClient`가 헤더를 붙이지 않고, 붙이려면 WebGL 재빌드와 `Build/` 커밋이
# 따라온다. 그래서 인증 기본값이 "꺼짐"이었고, 켜면 대시보드가 401로 멈췄다.
#
# 그 전달을 여기서 한다. envsubst가 채운 키를 **문서 응답의 쿠키로** 내려 주면 브라우저가
# 이후의 same-origin 요청에 자동으로 붙인다 — `/api/` XHR과 `/api/v1/ws` 핸드셰이크
# 양쪽이다. 번들을 다시 굽지 않고 키를 들여보내는 유일한 경로다(#266의 (a)안은 키를
# 저장소에 커밋하고, (c)안은 재빌드와 첫 요청의 닭-달걀 문제를 새로 만든다).
#
# `SameSite=Strict`는 장식이 아니라 이 방식의 안전장치다. 쿠키 인증은 브라우저가 알아서
# 자격증명을 붙이므로 CSRF가 따라오는데(이 API에는 `POST /api/v1/db/diary` 같은 쓰기
# 경로가 있다), Strict가 cross-site 요청에서 쿠키를 떼기 때문에 임의 페이지의
# `fetch(..., { mode: "no-cors" })`는 인증 없는 요청이 되어 401에서 끝난다. 위
# 레이트리밋 주석이 "CORS는 방어가 되지 않는다"고 적어 둔 그 경로가 부수적으로 함께
# 닫힌다. 이 속성을 Lax·None으로 내리는 것은 인증 방식을 바꾸는 일이다.
#
# 단 "site"는 **스킴 + 등록가능도메인**이고 포트는 보지 않는다(PR #363 리뷰). 같은
# 호스트의 다른 포트에 페이지가 뜨면 그건 same-site라 쿠키가 그대로 실린다. 지금 전
# 인터페이스에 게시되는 서비스는 frontend(8080) 하나뿐이고 나머지는 루프백 전용이라
# (#246·#285) 실제로 그런 페이지가 없지만, 새 서비스를 전 인터페이스에 게시할 때는
# "임의 페이지"의 범위가 그만큼 넓어진다는 뜻이다.
#
# `HttpOnly`도 준다. 번들은 이 값을 자바스크립트로 읽을 필요가 없다 — 브라우저가 붙이는
# 것이 이 방식의 전부다. WebSocket 핸드셰이크에도 그대로 붙는다(HttpOnly는 스크립트의
# 읽기만 막고 네트워크 계층의 전송은 막지 않는다).
#
# ⚠️ 그렇다고 키가 비밀이 되는 것은 아니다. **페이지를 열 수 있는 사람은 API도 부를 수
# 있다** — 그 페이지의 자바스크립트가 내는 요청에 브라우저가 쿠키를 붙여 주고, 개발자
# 도구의 쿠키 목록에는 값 자체가 보인다. 이 성질은 (a)·(b)·(c) 세 안 모두에 똑같이
# 있는 것이고(#266 2026-09-04 코멘트), 없애려면 로그인이나 네트워크 레벨 인증이
# 필요하다. 이 배포에서 브라우저 경계를 맡는 것은 Tailscale이다.
#
# ⚠️ 키에 못 쓰는 문자가 있다. 깨지는 이유가 둘로 갈린다.
#   - `$`·`"` — 치환 결과가 nginx **설정 문법**에 섞인다. `"`는 기동 실패로 끝나지만,
#     `$`는 하필 실재하는 변수 이름이 뒤따르면(`abc$host`) 조용히 그 값으로 치환돼
#     backend가 아는 키와 다른 쿠키가 나간다.
#   - `;`·`,`·`\`·공백 — nginx는 통과시키지만 **쿠키 값**에 쓸 수 없는 문자다
#     (RFC 6265 cookie-octet). 브라우저가 값을 거기서 끊어 보내 401이 된다.
# 어느 쪽이든 증상은 frontend에만 나타나므로, 같은 `.env`를 먼저 읽는 backend가 기동
# 로그로 미리 경고한다(backend/main.py의 unsafe_key_characters).

# `Secure`는 스킴을 보고 붙인다. 이 배포의 주 경로는 Tailscale 위의 평문 HTTP
# (`http://100.x.y.z:8080`)라 무조건 붙이면 브라우저가 쿠키를 저장하지 않고 대시보드가
# 401로 멈춘다 — 켠 것처럼 보이는데 안 켜진 상태다. 앞단에서 TLS를 끊는 프록시를 두면
# nginx가 보는 $scheme은 그래도 http이므로, 그 구성에서는 X-Forwarded-Proto를 신뢰하는
# 쪽으로 함께 고칠 것(위 X-Forwarded-For 주석과 같은 자리).
map $scheme $finus_cookie_secure {
    https   '; Secure';
    default '';
}

# 키가 비어 있으면(= 인증 미설정, 기본값) 쿠키 문자열도 빈 문자열이 되고, nginx는 값이
# 빈 add_header를 아예 내보내지 않는다. 그래서 인증을 끈 배포에는 Set-Cookie가 붙지
# 않는다 — `finus_api_key=`라는 빈 쿠키를 심어 두면 나중에 인증을 켠 날 브라우저가 그
# 빈 값을 먼저 보내고, 키를 채웠는데 401인 상태가 된다.
#
# 쿠키 이름은 backend/main.py의 API_KEY_COOKIE와 같아야 한다. 실행 경계를 넘는 계약이라
# 한쪽만 바꾸면 인증을 켠 날에야 드러나므로, backend/tests/test_nginx_api_key_cookie.py가
# 이 파일을 텍스트로 읽어 대조한다.
map $finus_injected_key $finus_api_key_cookie {
    ''      '';
    default "finus_api_key=$finus_injected_key; Path=/; SameSite=Strict; HttpOnly$finus_cookie_secure";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # envsubst가 채우는 자리. 위 map이 이 값을 읽어 Set-Cookie 문자열을 만든다.
    # map은 참조 시점(헤더 필터)에 평가되므로, rewrite 단계의 이 set이 항상 먼저다.
    #
    # ⚠️ 변수 이름이 `finus_api_key`가 **아닌** 것은 의도다. nginx는 변수 이름을 소문자로
    # 접어 다루므로 `$finus_api_key`와 `${FINUS_API_KEY}`가 같은 변수다. 이름을 그렇게
    # 맞춰 두면 이 줄이 "자기 값을 자기에게 대입"이 되어, 치환이 일어나지 않은 배포에서
    # nginx가 **정상 기동한 뒤** 요청마다 `using uninitialized "finus_api_key" variable`
    # 경고만 남기고 쿠키를 조용히 빼먹는다(실측 확인). 이름을 갈라 둔 지금은 같은 상황이
    # 기동 실패로 즉시 드러난다 — `[emerg] unknown "finus_api_key" variable`(nginx가
    # 이름을 소문자로 접어 그렇게 보고한다). 막는 것처럼 보이는 상태를 만들지 않는다.
    set $finus_injected_key "${FINUS_API_KEY}";

    # nginx가 스스로 내는 리다이렉트(예: /api → /api/ 자동 슬래시 보정)를 상대 경로로
    # 낸다. 기본값 on이면 Location을 절대 URL로 만들면서 server_name(_)과 리스닝 포트
    # 기준으로 조립해 "http://localhost/api/"처럼 실제 포트(8080)가 빠진다.
    # proxy_set_header Host에서 $http_host를 쓴 것과 같은 이유다(실측 확인).
    absolute_redirect off;

    # nginx:alpine 기본값이 on이라 Server 헤더와 에러 페이지에 버전이 그대로 나간다.
    # 이 설정은 backend 미기동 시의 502 페이지에도 적용된다(PR #252 리뷰).
    server_tokens off;

    # 프록시 응답에도 붙도록 always를 준다(4xx·5xx에는 always 없이는 안 붙는다).
    # CSP는 Unity WebGL 로더가 unsafe-eval을 요구하므로 별도 검증 후에 다룬다.
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # nginx 자체 생존 확인용. /health는 backend로 프록시되므로 frontend의 healthcheck로
    # 쓰면 backend가 죽었을 때 frontend까지 unhealthy가 되고, depends_on을 일부러 뺀
    # 이 설정의 취지가 무효가 된다. compose에 frontend healthcheck를 넣게 되면
    # 반드시 이 경로를 쓸 것(PR #252 리뷰).
    # Content-Type은 add_header가 아니라 default_type으로 준다. location 레벨에
    # add_header를 하나라도 두면 상위(server)의 add_header 집합 전체가 상속되지 않아
    # 위 보안 헤더 3종이 이 응답에서만 빠진다. add_header는 교체가 아니라 추가라서
    # Content-Type이 두 번 나가기도 한다(실측 확인).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- backend 리버스 프록시 (#245) ---
    #
    # 브라우저가 8000번을 직접 부르던 cross-origin 구조를 same-origin으로 바꾼다.
    # 대시보드를 어떤 오리진(localhost·Tailscale·리버스 프록시 뒤)으로 열든 API 호출이
    # 같은 오리진의 /api/로 나가므로 CORS가 개입하지 않는다. 번들 소스가 상대 경로를 쓰게
    # 되면서(#246·#262) 이 경로가 유일한 API 경로가 됐고, 그에 따라 backend의
    # CORSMiddleware도 제거했다(#246). 즉 API로 향하는 브라우저 트래픽은 전부 여기를
    # 지나므로, 아래 레이트리밋이 실제로 전부를 덮는다.
    #
    # frontend에 depends_on을 붙이지 않으려고 proxy_pass에 변수를 쓴다. 상수 호스트명을
    # 쓰면 nginx가 기동 시점에 backend를 해석하고 실패하면 아예 뜨지 않는데, 변수를 쓰면
    # 요청 시점에 resolver로 해석하므로 backend가 아직 없어도 정적 화면은 먼저 뜬다
    # (그동안 /api 호출만 502). 127.0.0.11은 Docker 내장 DNS다. Docker DNS의 AAAA 응답에
    # 기대지 않도록 ipv6=off를 둔다.
    #
    # proxy_pass에 변수를 쓰고 URI 부분을 적지 않으면 원본 요청 URI가 그대로 전달된다.
    # 즉 /api/v1/portfolio → http://backend:8000/api/v1/portfolio.
    #
    # ⚠️ 아래 proxy_pass에 URI를 절대 붙이지 말 것. 상수 proxy_pass와 달리 변수 형태에서
    # URI를 적으면(예: http://$backend_upstream/) location 프리픽스 치환이 아니라 요청
    # URI 전체가 그 값으로 대체되어, 모든 요청이 backend의 /로 간다. 슬래시 하나로
    # 전부 깨지는 자리다(PR #252 리뷰).
    resolver 127.0.0.11 ipv6=off valid=10s;

    # 프록시 공통 헤더·타임아웃. 정적 location은 프록시를 타지 않으므로 영향이 없다.
    proxy_http_version 1.1;
    # $host가 아니라 $http_host다. $host는 포트를 떼므로 backend가 보는 Host가
    # "localhost"가 되고, FastAPI가 trailing slash 등으로 307을 낼 때 Location이
    # http://localhost/... 로 나가 포트(8080)가 사라진다. $http_host는 클라이언트가
    # 보낸 host:port를 그대로 넘긴다.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    # $proxy_add_x_forwarded_for가 아니라 $remote_addr다. 전자는 클라이언트가 보낸
    # X-Forwarded-For 뒤에 이어붙이므로, 공격자가 헤더를 위조하면 backend가 받는
    # 첫 값이 위조값이 된다. 이 구성에서는 nginx가 최앞단이라 덮어쓰는 쪽이 맞다.
    # 앞단에 CDN·LB를 두게 되면 $proxy_add_x_forwarded_for로 되돌려야 한다(PR #252 리뷰).
    #
    # 다만 지금 이 두 헤더는 backend에 도달해도 소비되지 않는다. uvicorn의
    # forwarded_allow_ips 기본값이 127.0.0.1이라 compose 네트워크(172.x)에서 오는 nginx
    # 연결은 신뢰 대상이 아니고, backend 코드에도 request.client·X-Forwarded·root_path
    # 사용처가 없다. 즉 아래 두 줄은 동작 중인 보호가 아니라 장래 대비다. 실제로
    # 쓰려면 backend/Dockerfile의 uvicorn CMD에 --forwarded-allow-ips가 필요하다.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_send_timeout 300s;
    # /api/v1/analyze는 LLM·멀티 에이전트 호출이라 기본 60s로는 짧다.
    proxy_read_timeout 300s;

    # 초과 시의 상태 코드. 기본값은 503(Service Temporarily Unavailable)인데, 그러면
    # "서버가 잠깐 죽었다"와 "네가 너무 많이 불렀다"가 같은 코드로 나가 호출자가 재시도
    # 간격을 정할 수 없다. 클라이언트에게는 둘 다 429로 나간다.
    #
    # 다만 두 거절은 성질이 다르다. limit_req는 "너무 빨리 불렀다"라 잠깐 기다리면
    # 풀리지만, limit_conn은 "진행 중인 분석이 이미 상한만큼 있다"라 그 분석이 끝나야
    # 풀리고 그건 proxy_read_timeout 300s까지 갈 수 있다. 같은 안내를 내면 conn 쪽에서
    # 거짓말이 된다 — 10초 뒤 다시 부르라고 해놓고 그때도 429다.
    #
    # error_page는 상태 코드로만 갈라낼 수 있어서, 둘을 다른 본문으로 내보내려면 내부
    # 코드를 달리 써야 한다. 430은 IANA 미할당이고 바로 아래 error_page가 가로채므로
    # 클라이언트에게 나가지 않는다(실측: limit_conn 거절 응답은 429다).
    limit_req_status 429;
    limit_conn_status 430;

    # 본문을 nginx 기본 HTML 대신 FastAPI와 같은 모양의 JSON으로 낸다.
    # Unity의 ApiClient.ExtractErrorMessage는 실패 응답 본문을 {"detail": "..."}로 읽어
    # 그 문자열을 배너에 그대로 싣고, 파싱에 실패하면 "분석 실패: ... status=429"라는
    # 기계적인 문구로 떨어진다. 여기서 detail을 주면 번들을 다시 굽지 않고도 사용자에게
    # 읽히는 안내가 나간다(Unity 소스를 고치면 WebGL 재빌드와 Build/ 커밋이 따라온다 —
    # frontend/README.md).
    #
    # backend가 스스로 429를 내는 경우는 여기 걸리지 않는다. proxy_intercept_errors가
    # 기본 off라 업스트림 응답은 error_page를 타지 않고 그대로 통과한다.
    error_page 429 = @too_many_requests;
    error_page 430 = @analysis_in_flight;

    location @too_many_requests {
        default_type application/json;
        # Retry-After는 가장 빡빡한 zone인 finus_analyze(6r/m = 10초 간격)에 맞춘다.
        # 힌트이므로 느슨한 zone에서는 실제보다 길게 기다리라고 말하는 셈인데, 짧게
        # 불러서 다시 막히는 것보다 낫다.
        add_header Retry-After 10 always;
        # location에 add_header를 하나라도 두면 server 레벨 add_header 집합 전체가
        # 상속되지 않는다(위 /nginx-health 주석과 같은 이유). 보안 헤더 3종을 다시 적는다.
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        return 429 '{"detail":"요청이 너무 잦습니다. 잠시 후 다시 시도해 주세요."}';
    }

    location @analysis_in_flight {
        default_type application/json;
        # Retry-After를 일부러 붙이지 않는다. 언제 풀릴지는 진행 중인 분석의 남은
        # 시간에 달렸는데 서버가 그걸 모른다. 상한인 300s를 그대로 적으면 대개 필요
        # 이상으로 기다리게 하고, 짧게 적으면 그 시각에 다시 429다. 모르는 값을
        # 지어내느니 헤더를 빼는 쪽이 맞다(RFC 9110에서 선택 헤더다).
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        return 429 '{"detail":"이미 진행 중인 분석이 있습니다. 끝난 뒤 다시 시도해 주세요."}';
    }

    # analyze만 따로 낮게 잡는다. `=`는 정확히 일치하는 location이라 쿼리스트링
    # (`?stock=...&provider=...`)은 매칭에 관여하지 않는다. 정확 매칭은 프리픽스보다
    # 먼저 뽑히므로 아래 `location /api/`보다 우선한다 — 대신 location 사이에는 상속이
    # 없어 프리픽스 쪽 limit_req가 여기로 따라오지 않는다. 그래서 두 zone을 함께 적는다.
    #
    # 6r/m(10초 간격) + burst=2: 사람이 누르는 분석 한 건은 수십 초~수 분이 걸리므로
    # 정상 사용은 이 한도에 닿지 않고, 더블클릭이나 즉시 재시도만 burst가 흡수한다.
    # nodelay를 준 이유는, 없으면 초과분을 거절하는 대신 간격에 맞춰 **지연**시키는데
    # 그동안 커넥션이 살아 있어 proxy_read_timeout 300s와 겹치면 막으려던 점유가 오히려
    # 늘기 때문이다.
    #
    # limit_conn 2는 진행 중인 LLM 호출의 동시 상한이다. 레이트만으로는 간격을 지키며
    # 천천히 쌓는 패턴을 못 막는다.
    #
    # 스케줄러의 자동 분석은 여기 걸리지 않는다 — backend/scheduler.py가
    # perform_stock_analysis를 같은 프로세스에서 직접 부르고 HTTP를 타지 않기 때문이다.
    # 감시 주기(10분)와 이 한도를 맞출 필요가 없는 것도 그래서다. 스케줄러가 언젠가
    # 자기 HTTP API를 부르게 되면 이 전제가 깨지므로 그때 한도를 다시 볼 것.
    location = /api/v1/analyze {
        limit_req zone=finus_api burst=20 nodelay;
        limit_req zone=finus_analyze burst=2 nodelay;
        limit_conn finus_analyze_conn 2;

        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream;
    }

    # 나머지 API. news·trading/trend는 MCP 서버를 통해 외부 API를, trading/balance는
    # KIS API를 부르므로 무제한으로 둘 수 없다. 2r/s + burst=20은 대시보드가 버튼 조작과
    # 최초 포트폴리오 로드로 내는 양보다 훨씬 넉넉하다.
    #
    # /api/v1/ws(WebSocket)도 이 프리픽스에 걸린다. 핸드셰이크 GET 한 번만 계산되고
    # 이후 프레임은 세지 않으므로 상시 연결에는 영향이 없다. limit_conn을 여기 걸지
    # 않은 것은 의도다 — WS는 원래 오래 붙어 있어서, 동시 연결 제한을 걸면 정상 연결
    # 하나가 그 예산을 계속 물고 있게 된다.
    location /api/ {
        limit_req zone=finus_api burst=20 nodelay;

        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream;
    }

    # 예전 vite dev server가 /api와 함께 프록시하던 경로. backend/main.py의 /health다.
    # backend까지 왕복하므로 정적 자산과 달리 제한 대상에 넣는다. nginx 자체 생존
    # 확인용인 /nginx-health는 프록시를 타지 않고 제한도 없으므로, 감시 도구는 그쪽을
    # 쓰면 한도와 무관하다.
    location = /health {
        limit_req zone=finus_api burst=20 nodelay;

        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream;
    }

    # Unity 로더는 .wasm을 WebAssembly.instantiateStreaming으로 받으므로 Content-Type이
    # 정확히 application/wasm이어야 한다(frontend/README.md 참고). nginx 1.21.5+ 기본
    # mime.types에 이미 매핑이 있지만, 베이스 이미지가 바뀌어 빠지더라도 default_type이
    # 받아내도록 명시해 둔다. types 블록을 새로 열면 상속받은 매핑 전체가 대체되므로
    # 여기서는 location + default_type 방식을 쓴다.
    location ~ \.wasm$ {
        default_type application/wasm;
    }

    # --- 문서 응답: 여기서만 API 키 쿠키를 내려 준다 (#266 3단계) ---
    #
    # 정적 자산까지 실으면 번들 하나를 받는 동안 같은 Set-Cookie가 요청 수십 개에
    # 따라붙고, 앞단에 캐시를 두는 순간 그 응답들이 키를 품은 채 저장된다. 쿠키가
    # 필요한 것은 페이지를 처음 받는 순간 한 번뿐이다.
    #
    # `/`와 `/index.html`을 모두 적는다. 아래 `location /`의 try_files가 문서를 그대로
    # 내보내므로 한쪽만 적으면 그 주소로 들어온 사람에게는 쿠키가 가지 않고, 그건
    # 대시보드가 401로 멈추는 것으로만 드러난다. location 사이에는 상속이 없어 보안 헤더
    # 3종도 각각 다시 적어야 한다(위 /nginx-health·@too_many_requests와 같은 이유).
    # 이 중복은 backend/tests/test_nginx_api_key_cookie.py가 대조한다.
    #
    # ⚠️ `Cache-Control: no-cache`가 이 방식을 성립시킨다(PR #363 리뷰). 쿠키는
    # Max-Age·Expires가 없는 **세션 쿠키**라 브라우저를 닫으면 사라지는데, 문서에 캐시
    # 지시가 없으면 브라우저가 Last-Modified 기준 휴리스틱으로 캐싱해(대략 age의 10%)
    # 다음 방문의 네비게이션이 네트워크를 타지 않는다. 그러면 쿠키는 없고 문서는 캐시에서
    # 나와 **새 쿠키를 받을 기회가 없다** — 대시보드가 401로 멈추고, 서버 로그에는 아무
    # 흔적이 없다. 키 회전도 같은 이유로 깨진다(컨테이너를 다시 만들어도 캐시된 문서를 쓰는
    # 브라우저는 낡은 쿠키를 계속 보낸다).
    #
    # no-store가 아니라 no-cache인 것은 재검증 응답(304)에도 Set-Cookie가 실리기 때문이다
    # — 실측했다(nginx:alpine, If-None-Match·If-Modified-Since 양쪽 304에 쿠키·보안 헤더가
    # 그대로 나왔다). 즉 본문을 다시 보내지 않으면서 키는 매번 최신이다.
    #
    # 정적 자산에는 일부러 걸지 않는다. 번들은 53MB짜리 .wasm을 포함하고, 그건 캐시가
    # 동작해야 하는 쪽이다.
    location = / {
        add_header Cache-Control "no-cache" always;
        add_header Set-Cookie $finus_api_key_cookie always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Set-Cookie $finus_api_key_cookie always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;

    # 빌드 타임에 만들어 둔 .gz가 있으면 그대로 내보낸다. 동적 압축과 달리
    # Content-Length가 보존되므로 아래에 적은 로더 진행률 문제가 생기지 않는다.
    # 지금 추적 중인 번들에는 .gz가 없어 실질 효과는 없고, Unity 빌드 설정을 압축
    # 산출물로 바꾸는 시점에 바로 동작하도록 자리만 잡아 둔다.
    gzip_static on;

    # .wasm(application/wasm)과 .data(application/octet-stream)는 일부러 뺐다.
    # 동적 gzip이 걸리면 nginx가 Content-Length를 지우고 chunked로 보내는데,
    # Build.loader.js는 그 헤더로 수신 버퍼 크기를 잡는다(parseInt(null) → NaN).
    # 그러면 로딩바가 첫 청크에서 튄 뒤 내려받는 내내 멈춘 것처럼 보이고,
    # 로더가 원래 띄우는 Content-Length 누락 경고도 뜨지 않아 조용히 깨진다.
    # 실측(nginx 1.31.3): Accept-Encoding: gzip 요청 시 두 파일 모두 Content-Length가
    # 사라지고 Transfer-Encoding: chunked로 나갔다.
    # 53.7MB wasm을 요청마다 실시간 압축하던 비용도 함께 사라지고, sendfile과
    # Range 요청(중단 재개)이 복구된다.
    #
    # .js는 이 이미지(1.31.3)의 mime.types에서 application/javascript로 매핑되지만,
    # 상류가 text/javascript로 바꾼 이력이 있어 두 타입을 모두 적어 둔다.
    gzip_types text/css text/javascript application/javascript image/svg+xml;
}
