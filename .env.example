# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma4:e4b
OLLAMA_API_KEY=ollama

# ─────────────────────────────────────────────────────────────────────────
# 한국투자증권(KIS)
# ─────────────────────────────────────────────────────────────────────────
# KIS_ 접두사 변수는 MCP 서버(mcp/) 자식 프로세스로 전달된다. backend 전용 비밀값에 쓰지 말 것.
KIS_API_KEY=your_kis_api_key_here
KIS_API_SECRET=your_kis_api_secret_here
KIS_ACCOUNT_NO=1234567801

# 모의투자 (기본)
KIS_URL=https://openapivts.koreainvestment.com:29443
KIS_ORDER_ENV=demo
# 실전투자: KIS_URL을 아래 주소로 바꾸고 KIS_ORDER_ENV=real, KIS_REAL_ORDER_ENABLED=true. 실제 자금으로 체결됨.
#KIS_URL=https://openapi.koreainvestment.com:9443
KIS_REAL_ORDER_ENABLED=false

# 영숫자·9자 종목코드(ETN, 신형우선주, 펀드) 주문 허용. 모의투자 전용, 정확히 "true"만 켜짐.
# KIS_ALNUM_STOCK_ORDER_ENABLED=true

# KIS 토큰 캐시 파일 경로 (선택, 기본은 OS 임시 디렉터리). 캐시 파일은 언제 지워도 안전.
# KIS_TOKEN_CACHE_PATH=/path/to/kis-token-cache.json

# 중복 주문 방지 원장 경로 (선택). Docker는 /app/.state/kis-order-dedup.json이 기본(컨테이너 내부 경로).
# KIS_ORDER_DEDUP_PATH=/app/.state/kis-order-dedup.json
# 같은 주문 중복 차단 시간(ms, 기본 2분)
# KIS_ORDER_DEDUP_TTL_MS=120000

# 조회 TR ID 재정의 (선택, 기본은 KIS_URL로 모의/실전 자동 선택)
# KIS_TR_ID_DAILY_CCLD=TTTC0081R
# KIS_TR_ID_BALANCE_RLZ_PL=TTTC8494R
# KIS_TR_ID_PSBL_ORDER=TTTC8908R

# 연속조회 페이지 간 대기(ms, 기본 0). 유량 제한(EGW00201) 오류가 나면 올린다.
# KIS_DAILY_CCLD_PAGE_DELAY_MS=0
# KIS_BALANCE_RLZ_PL_PAGE_DELAY_MS=0

# KIS 요청별 타이밍 로그 (기본 off). 유량 측정할 때만 켤 것.
# KIS_REQUEST_LOG=0

# ─────────────────────────────────────────────────────────────────────────
# 뉴스·공시
# ─────────────────────────────────────────────────────────────────────────
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
DART_API_KEY=your_dart_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# backend
# ─────────────────────────────────────────────────────────────────────────
DB_ECHO=false

# 신호 유의성 점수(-3~+3)의 절댓값이 이 값 이상이면 상세 분석 (1~3, 기본 2)
# SIGNAL_SCORE_THRESHOLD=2
# 기사별 점수 표준편차가 이 값 이상이면 알림에 "기사 간 평가 엇갈림" 표시
# SIGNAL_UNCERTAINTY_ALERT_THRESHOLD=1.0
# 상세 분석까지 가지 않은 신호의 점수 보관 기간(일, 1~365, 기본 30)
# FILTERED_SIGNAL_RETENTION_DAYS=30

# 호스트에서 backend를 직접 띄울 때 쓰는 주소. Docker에서는 compose가 덮어씀.
REDIS_URL=redis://127.0.0.1:6379/0
NAT_BASE_URL=http://127.0.0.1:8001

# 켜면 외부 LLM으로 보내는 프롬프트의 마스킹 전·후를 DEBUG 로그로 남김. 평문 계좌 정보가 찍히므로 로컬 확인용.
# PII_EGRESS_DEBUG_LOG=true

# ─────────────────────────────────────────────────────────────────────────
# 텔레그램
# ─────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# /visualize가 보내는 대시보드 주소
VISUALIZATION_URL=http://100.x.y.z:8080/

# ─────────────────────────────────────────────────────────────────────────
# 보안
# ─────────────────────────────────────────────────────────────────────────
# 대시보드를 여는 오리진 목록(쉼표 구분). 실시간 알림 WebSocket의 Origin 검사에 쓰임.
# 등록하지 않은 오리진에서 열면 화면은 뜨지만 실시간 알림이 끊김. `*`는 운영에서 쓰지 말 것.
ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API 정적 키. 채우면 /api/ 전체와 WebSocket이 이 키를 요구하고, 비우면 인증이 꺼짐.
# - scripts/setup_env.sh가 .env를 처음 만들 때 난수 키를 채움.
# - 브라우저는 nginx가 쿠키로 넣어 줌. curl 등은 `X-API-Key` 헤더로 직접 전달.
# - 바꾸면 frontend도 다시 만들어야 함: docker compose up -d backend frontend
# - Unity 에디터 플레이 모드로 테스트할 때는 비울 것 (쿠키를 받지 못함).
# - `$` `"` `;` `,` `\` 공백은 쓸 수 없음. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINUS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 멀티 에이전트 (agents)
# ─────────────────────────────────────────────────────────────────────────
# 투자 성향 메모리 (기본 1). 0이면 메모리 없이 실행.
# FINUS_MEM0_ENABLED=1
# FINUS_MEM0_STORAGE_DIR=.state/mem0
# KIS Trading MCP 서버 주소 (기본 http://host.docker.internal:3300/sse)
# FINUS_KIS_TRADING_MCP_URL=http://localhost:3300/sse
# KIS Trading MCP 서버를 띄울 때 준 MCP_ACCESS_TOKEN과 같은 값 (서버가 필수로 요구)
FINUS_KIS_TRADING_MCP_TOKEN=
# 매매일지 API용 backend 주소 (Docker에서는 http://backend:8000)
# FINUS_BACKEND_URL=http://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────────────────
# AI 주문 제안(/advise) 한도. 미설정·잘못된 값이면 아래 기본값.
# ─────────────────────────────────────────────────────────────────────────
# ORDER_MAX_ORDER_AMOUNT=1000000            # 1회 주문 금액 상한(원)
# ORDER_MAX_POSITION_RATIO=0.20             # 한 종목 비중 상한
# ORDER_MAX_DAILY_COUNT=10                  # 일 주문 횟수 상한
# ORDER_MAX_DAILY_AMOUNT=3000000            # 일 거래대금 상한(원)
# ORDER_MIN_CASH_RATIO=0.10                 # 주문 후 최소 현금 비중
# ORDER_MAX_PRICE_GAP_RATIO=0.03            # 지정가-현재가 허용 괴리 (agents도 같은 값 사용)
# ORDER_MIN_CONFIDENCE=0.6                  # 확신도 하한 (검증 에이전트 참고용)
# ORDER_REPROPOSAL_COOLDOWN_MINUTES=60      # 같은 종목 재제안 대기 시간
# 주문 금지 종목코드(쉼표 구분)
# ORDER_BLACKLIST=
# ORDER_PROPOSE_TIMEOUT_SECONDS=120
# ORDER_VERIFY_TIMEOUT_SECONDS=40
# VERIFIER_OPENAI_CHAT_MODEL=gpt-5.4-mini
# FINUS_ORDER_VERIFIER_TIMEOUT_SEC=30

# 감시 신호로 주문 제안 자동 생성 (기본 꺼짐, 정확히 "true"만 켜짐).
# 주문이 바로 나가지 않고 확정 버튼이 달린 대기 주문까지만 생성됨. 대상은 관심·보유 종목.
# ORDER_RULE_TRIGGER_ENABLED=true
# ORDER_RULE_SOURCES=news,disclosure
# ORDER_RULE_URGENCY_LEVELS=critical
